# Copy to .env and adjust. Never commit .env.
POSTGRES_DB=scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=scheduler_dev_pw
POSTGRES_PORT=5432
RABBITMQ_USER=scheduler
RABBITMQ_PASSWORD=scheduler_dev_pw
# Must be >= 32 bytes. Signs JWTs (M2, ADR-0005). The API reads config key Jwt:SigningKey (env Jwt__SigningKey)
# and falls back to JWT_SIGNING_KEY. Development uses a dev-only value from appsettings.Development.json.
JWT_SIGNING_KEY=dev-only-signing-key-change-me-please-32+chars
# OpenTelemetry (ADR-0010). Empty = no export. Development defaults to Jaeger's OTLP port in appsettings.Development.json.
Observability__OtlpEndpoint=http://localhost:4317
Observability__MetricsEndpoint=
# Messaging (ADR-0007). The API reads Messaging:RabbitMq:* — keep user/password in sync with RABBITMQ_USER/PASSWORD above.
# Enabled=false runs Wolverine on its PostgreSQL store only (no broker); a broker that is down at startup → degraded mode.
Messaging__RabbitMq__Host=localhost
Messaging__RabbitMq__UserName=scheduler
Messaging__RabbitMq__Password=scheduler_dev_pw
Messaging__RabbitMq__Enabled=true
