# Copy to .env and adjust. Never commit .env.
POSTGRES_DB=scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=scheduler_dev_pw
POSTGRES_PORT=5432
RABBITMQ_USER=scheduler
RABBITMQ_PASSWORD=scheduler_dev_pw
# Must be >= 32 bytes. Signs JWTs (M2, ADR-0005). The API reads config key Jwt:SigningKey (env Jwt__SigningKey)
# and falls back to JWT_SIGNING_KEY. Development uses a dev-only value from appsettings.Development.json.
JWT_SIGNING_KEY=dev-only-signing-key-change-me-please-32+chars
