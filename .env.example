# Copy to .env and adjust. Never commit .env. Every value has a default, so .env is optional.
# docker compose reads this file for the containers; a locally run API (dotnet run) reads the Messaging__/Observability__
# variables only if you export them in your shell (otherwise appsettings*.json applies).

# ── Docker compose: infrastructure ─────────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=P@ssword!
POSTGRES_PORT=5432
# RabbitMQ: guest/guest is for local Docker only — set real credentials in any shared or hosted environment.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ── Docker compose: application ports (plan 014) ───────────────────────────────────────────────────────────────────
# Web app (nginx + Angular, proxies /api) and the API (Scalar at /scalar).
WEB_PORT=8080
API_PORT=5080
# Optional database UI (`docker compose --profile tools up -d pgadmin`), bound to 127.0.0.1.
PGADMIN_PORT=5050

# ── Locally run API (dotnet run) ───────────────────────────────────────────────────────────────────────────────────
# Must be >= 32 bytes. Signs JWTs (ADR-0005). The API reads config key Jwt:SigningKey (env Jwt__SigningKey)
# and falls back to JWT_SIGNING_KEY. Development uses a dev-only value from appsettings.Development.json.
JWT_SIGNING_KEY=dev-only-signing-key-change-me-please-32+chars
# OpenTelemetry (ADR-0010). Empty = no export. Development defaults to Jaeger's OTLP port in appsettings.Development.json.
Observability__OtlpEndpoint=http://localhost:4317
Observability__MetricsEndpoint=
# Messaging (ADR-0007). Keep user/password in sync with RABBITMQ_USER/PASSWORD above.
# Enabled=false runs Wolverine on its PostgreSQL store only (no broker); a broker that is down at startup → degraded mode.
Messaging__RabbitMq__Host=localhost
Messaging__RabbitMq__UserName=guest
Messaging__RabbitMq__Password=guest
Messaging__RabbitMq__Enabled=true
