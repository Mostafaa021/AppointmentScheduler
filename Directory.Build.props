<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Noise for this app size; CA1862 is wrong inside EF LINQ (ToLower().Contains translates to SQL). CA1873 (cost of log
         arguments when logging is off) is the same perf family as CA1848 and flags boxing a Guid?. Real issues stay errors. -->
    <NoWarn>$(NoWarn);CA1062;CA1848;CA1515;CA1711;CA2007;CA1716;CA1812;CA1852;CA1031;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1724;CA1720;CA1056;CA1054;CA2201;CA1859;CA1822;CA1002;CA2227;CA1819;CA1034;CA1707;CA1862;CA1873</NoWarn>
  </PropertyGroup>
</Project>
