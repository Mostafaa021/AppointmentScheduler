{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Scheduler": "Host=localhost;Port=5432;Database=scheduler;Username=scheduler;Password=scheduler_dev_pw"
  },
  "Clinic": {
    "TimeZone": "Europe/London",
    "Open": "09:00",
    "Close": "17:00",
    "SlotMinutes": 30
  },
  "Seed": {
    "Enabled": true
  },
  "BackgroundJobs": {
    "Enabled": true
  },
  "Jwt": {
    "Issuer": "appointment-scheduler",
    "Audience": "appointment-scheduler-web"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Observability": {
    "ServiceName": "appointment-scheduler-api",
    "OtlpEndpoint": "",
    "MetricsEndpoint": ""
  },
  "Messaging": {
    "RabbitMq": {
      "Enabled": true,
      "Host": "localhost",
      "Port": 5672,
      "UserName": "scheduler",
      "Password": "",
      "ProbeTimeoutSeconds": 3
    },
    "Publishing": {
      "Exchange": "appointment-scheduler.events"
    },
    "RecoveryIntervalMinutes": 1
  }
}
